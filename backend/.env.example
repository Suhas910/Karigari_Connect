DATABASE_URL=sqlite:///./craftlink.db
SECRET_KEY=development_secret_key_change_in_production_12345

# Gemini. Unset = AI endpoints use labelled fixtures.
# GEMINI_API_KEY=

# Speech to text (app/ai/adapters/).
#   legacy   (default) the old path; it does not send the recording anywhere
#   gemini   sends the uploaded recording to Gemini; needs GEMINI_API_KEY
#   local    faster-whisper on this machine (pip install faster-whisper)
# CRAFTLINK_ASR=legacy
# CRAFTLINK_GEMINI_MODEL=gemini-3.5-flash

# Catalogue generation. legacy = free-text extraction with a fixed fallback listing.
#   gemini   schema-constrained generation from a gemini or local transcript
# CRAFTLINK_CATALOGUE=legacy

# Photos. legacy = grades a URL string without opening the photo.
#   studio   grades and enhances the uploaded photo (needs requirements-ai.txt; the
#            segmentation model, 4.6 MB for u2netp, downloads on first use)
# CRAFTLINK_IMAGE=legacy
# CRAFTLINK_SEGMENTATION_MODEL=u2netp
# Gemini second opinion on each photo (no product, person in frame). Costs one request per photo.
# CRAFTLINK_PHOTO_CHECK=off

# Uploaded media (app/storage.py).
#   local    (default) files under CRAFTLINK_MEDIA_DIR, default backend/media_store/
#   supabase the private `media` bucket; a public bucket is refused. The service-role
#            key stays server-side only, never in the frontend.
# CRAFTLINK_MEDIA_STORAGE=local
# CRAFTLINK_MEDIA_DIR=
# CRAFTLINK_MEDIA_BUCKET=media
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Wage table for the price engine. Leave unset: the shipped table has no rates and the
# price endpoint refuses (WAGE_RATE_UNAVAILABLE) rather than invent a floor. Set to
# `demo` only for a demo; every demo price is labelled as a fixture in the response.
# CRAFTLINK_WAGE_TABLE=
