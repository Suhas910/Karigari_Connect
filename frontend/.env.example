# Copy to .env to run the app against a real backend. Unset = offline mockApi.
#   iOS simulator:    http://localhost:8000/api/v1
#   Android emulator: http://10.0.2.2:8000/api/v1
#   Phone on Wi-Fi:   http://<this machine's LAN IP>:8000/api/v1
# Restart `expo start` after changing it; Expo reads EXPO_PUBLIC_* at bundle time.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
