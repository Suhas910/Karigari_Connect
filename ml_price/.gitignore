# Everything in ml_price/ is committed on purpose: data, exports, reports, figures.
# Only exclusion: product photos (~1.1 GB), too big for GitHub.
data/raw/**/images/
.ipynb_checkpoints/
.DS_Store

# Local Python environment (recreate: python3 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt)
.venv/
__pycache__/

# Local secrets (API keys) — never committed
.env

# Part 13: raw Orange image embeddings (~300 MB); the PCA-reduced file is committed instead
data/features/image_embeddings_squeezenet.tab

# Part 17: raw MiniLM embeddings (~57 MB); regenerated by scripts/part17_sentence_embeddings.py
data/features/sentence_emb_minilm.npy
