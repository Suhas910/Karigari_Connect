# Template for ml_price/.env (copy to .env and fill in). This example file is committed; it holds no secret.
# Get a free key: https://aistudio.google.com → "Get API key". Paste it after the = sign, no quotes, no spaces.
GEMINI_API_KEY=your-key-goes-in-.env-not-here

# Optional: which Gemini model to use. Leave blank to use the script's default (a current "Flash" model).
# If you set it, copy the exact model id shown in AI Studio.
GEMINI_MODEL=
