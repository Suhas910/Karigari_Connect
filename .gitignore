# Python virtual environments -- every common naming convention.
# `venv/` alone left `.venv/` unignored, which is the convention a `python -m venv .venv`
# would produce. A committed venv is thousands of binary files and is painful to undo.
venv/
.venv/
env/
ENV/
*.egg-info/

__pycache__/
*.pyc
.env
.DS_Store
.idea

.pytest_cache/

